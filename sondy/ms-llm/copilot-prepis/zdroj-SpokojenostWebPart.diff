+    if (odpoved.status === 429) throw new Error('Dnešní limit AI pro appku je vyčerpaný. Zkuste to zítra.');
+    if (odpoved.status === 401) throw new Error('Gateway odmítla přihlášení. Ověřte API oprávnění Gateway.Use.');
+    if (odpoved.status === 403) throw new Error('Gateway nezná appku „demo“. Ověřte její registraci u IT.');
+    if (odpoved.status === 502) throw new Error('Gateway soubor nezpracovala. Zkuste menší PDF nebo obrázek (do 3 MB).');
+    if (odpoved.status === 503) throw new Error('AI gateway se právě spouští. Zkuste to za chvíli znovu.');
+    if (!odpoved.ok) throw new Error(`AI gateway vrátila ${odpoved.status}.`);
+    return (await odpoved.json()) as T;
