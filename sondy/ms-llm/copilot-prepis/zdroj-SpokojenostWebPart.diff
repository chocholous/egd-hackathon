+  private async _ocr(soubor: File): Promise<string> {
+    const pripona = soubor.name.toLowerCase().split('.').pop();
+    if (soubor.type !== 'application/pdf' && !soubor.type.startsWith('image/') && pripona !== 'pdf') {
+      throw new Error('Vyberte PDF nebo obrázek.');
+    }
+    const bajty = new Uint8Array(await soubor.arrayBuffer());
+    let binarni = '';
+    for (let i = 0; i < bajty.length; i++) binarni += String.fromCharCode(bajty[i]);
+    const odpoved = await this._ai<{ text: string }>('/api/ocr', { base64: btoa(binarni), model: 'prebuilt-read' });
+    return odpoved.text;
+  }
