{
 "displayName": "EGD PA sonda: Word → PDF přes OneDrive Convert file (Standard)",
 "connectionReferences": {
  "shared_sharepointonline": {
   "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
   "tier": "NotSpecified",
   "connectionName": "egd-sonda-sharepointonline",
   "source": "Embedded"
  },
  "shared_onedriveforbusiness": {
   "id": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
   "tier": "NotSpecified",
   "connectionName": "egd-sonda-onedrive",
   "source": "Embedded"
  }
 },
 "definition": {
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
   "$connections": {
    "defaultValue": {},
    "type": "Object"
   },
   "$authentication": {
    "defaultValue": {},
    "type": "SecureObject"
   }
  },
  "triggers": {
   "Recurrence": {
    "type": "Recurrence",
    "recurrence": {
     "frequency": "Month",
     "interval": 12
    }
   }
  },
  "actions": {
   "Nacti_docx": {
    "type": "OpenApiConnection",
    "runAfter": {},
    "inputs": {
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "connectionName": "shared_sharepointonline",
      "operationId": "GetFileContentByPath"
     },
     "parameters": {
      "dataset": "https://pavelchocholousgmail.sharepoint.com/sites/egd-sonda-power-automate",
      "path": "/Shared Documents/sablona-test.docx",
      "inferContentType": true
     },
     "authentication": "@parameters('$authentication')"
    }
   },
   "Do_OneDrive": {
    "type": "OpenApiConnection",
    "runAfter": {
     "Nacti_docx": [
      "Succeeded"
     ]
    },
    "inputs": {
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
      "connectionName": "shared_onedriveforbusiness",
      "operationId": "CreateFile"
     },
     "parameters": {
      "folderPath": "/",
      "name": "sablona-test.docx",
      "body": "@body('Nacti_docx')"
     },
     "authentication": "@parameters('$authentication')"
    }
   },
   "Na_PDF": {
    "type": "OpenApiConnection",
    "runAfter": {
     "Do_OneDrive": [
      "Succeeded"
     ]
    },
    "inputs": {
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
      "connectionName": "shared_onedriveforbusiness",
      "operationId": "ConvertFile"
     },
     "parameters": {
      "id": "@body('Do_OneDrive')?['Id']",
      "type": "PDF"
     },
     "authentication": "@parameters('$authentication')"
    }
   },
   "Do_SharePointu": {
    "type": "OpenApiConnection",
    "runAfter": {
     "Na_PDF": [
      "Succeeded"
     ]
    },
    "inputs": {
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "connectionName": "shared_sharepointonline",
      "operationId": "CreateFile"
     },
     "parameters": {
      "dataset": "https://pavelchocholousgmail.sharepoint.com/sites/egd-sonda-power-automate",
      "folderPath": "/Shared Documents",
      "name": "sablona-test.pdf",
      "body": "@body('Na_PDF')"
     },
     "authentication": "@parameters('$authentication')"
    }
   }
  },
  "outputs": {}
 }
}