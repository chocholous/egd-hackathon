{
 "displayName": "EGD PA sonda: RSS bez HTTP (Standard)",
 "connectionReferences": {
  "shared_rss": {
   "id": "/providers/Microsoft.PowerApps/apis/shared_rss",
   "tier": "NotSpecified",
   "connectionName": "egd-sonda-rss",
   "source": "Embedded"
  }
 },
 "definition": {
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
   "$connections": {
    "defaultValue": {},
    "type": "Object"
   },
   "$authentication": {
    "defaultValue": {},
    "type": "SecureObject"
   }
  },
  "triggers": {
   "Recurrence": {
    "type": "Recurrence",
    "recurrence": {
     "frequency": "Month",
     "interval": 12
    }
   }
  },
  "actions": {
   "Feed": {
    "type": "OpenApiConnection",
    "runAfter": {},
    "inputs": {
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_rss",
      "connectionName": "shared_rss",
      "operationId": "ListFeedItems"
     },
     "parameters": {
      "feedUrl": "https://feeds.bbci.co.uk/news/rss.xml"
     },
     "authentication": "@parameters('$authentication')"
    }
   },
   "Pocet": {
    "type": "Compose",
    "runAfter": {
     "Feed": [
      "Succeeded"
     ]
    },
    "inputs": "@length(body('Feed'))"
   }
  },
  "outputs": {}
 }
}